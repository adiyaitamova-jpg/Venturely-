# ─── Required ────────────────────────────────────────────────
# PostgreSQL connection string (Postgres 14+).
DATABASE_URL="postgresql://venturely:venturely@localhost:5432/venturely?schema=public"
# Public base URL, used in password-reset links and metadata.
APP_URL="http://localhost:3000"

# ─── AI Mentor (optional, but required for AI features) ─────
# Server-side only. Without it, the app shows a configuration notice; the
# Teammate Matcher still returns deterministic skill-based matches.
ANTHROPIC_API_KEY=""
# Model and effort ("low" | "medium" | "high" | "xhigh" | "max").
AI_MODEL="claude-opus-5-5"
AI_EFFORT="medium"
# Server-side refusal fallback: "default" (recommended) or "off".
AI_FALLBACKS="default"
# Per-request timeout and per-user rolling 24h budgets.
AI_TIMEOUT_MS="90000"
AI_DAILY_REQUEST_LIMIT="40"
AI_DAILY_TOKEN_BUDGET="600000"

# ─── Email (optional) ───────────────────────────────────────
# Password-reset emails are sent through Resend when set. In development,
# without a key, reset links are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Venturely <no-reply@your-domain.example>"

# ─── Scheduled jobs (optional) ──────────────────────────────
# Protects GET /api/cron/rankings (send "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=""

# ─── Seeding & demo ─────────────────────────────────────────
# SEED_DEMO=false seeds only the skill taxonomy (use in production).
SEED_DEMO="true"
SEED_DEMO_PASSWORD="venturely-demo-1"
# Moderator password for admin@demo.venturely.dev (random if unset; printed by the seed).
SEED_ADMIN_PASSWORD=""
# Show the demo-login hint on the sign-in page.
NEXT_PUBLIC_SHOW_DEMO_LOGIN="true"

# Tests use a separate database whose name must contain "test".
TEST_DATABASE_URL="postgresql://venturely:venturely@localhost:5432/venturely_test?schema=public"
