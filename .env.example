# Postgres connection string. On Vercel, the Neon integration sets this for you.
DATABASE_URL="postgresql://user:password@localhost:5432/teami"
# The account registered with this email becomes the moderator (can verify achievements).
ADMIN_EMAIL="you@example.com"
# Optional: enables the AI Mentor. Usage is billed to this Anthropic API key.
ANTHROPIC_API_KEY=""
# Optional: model for the AI Mentor (default claude-opus-5-5).
AI_MODEL="claude-opus-5-5"
# Optional: AI requests per member per day (default 40).
AI_DAILY_LIMIT="40"
